APP_NAME=WisePlay
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=change_this_with_a_random_32_char_key
SESSION_NAME=WISEPLAYSESSID

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=wiseplay_php
DB_USERNAME=wiseplay_user
DB_PASSWORD=wiseplay_pass
DB_CHARSET=utf8mb4

ONEDRIVE_AUTHORITY=consumers
ONEDRIVE_SCOPES=openid offline_access profile User.Read Files.ReadWrite
ONEDRIVE_UPLOAD_DEBUG=0
ONEDRIVE_UPLOAD_CHUNK_MB=10
ONEDRIVE_UPLOAD_MAX_VIDEO_GB=10
ONEDRIVE_UPLOAD_MAX_RETRIES=3
ONEDRIVE_UPLOAD_RETRY_BACKOFF_MS=500

# Optional: allow manual profile creation in /admin/profiles
ADMIN_PROFILE_MAINTENANCE_MODE=false
